{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/login",           "destination": "/api/login.js" },
    { "source": "/api/logout",          "destination": "/api/logout.js" },
    { "source": "/api/me",              "destination": "/api/me.js" },
    { "source": "/api/solutions",       "destination": "/api/solutions.js" },
    { "source": "/api/solution",        "destination": "/api/solution.js" },
    { "source": "/api/review",          "destination": "/api/review.js" },
    { "source": "/api/users",           "destination": "/api/users.js" },
    { "source": "/api/user-detail",     "destination": "/api/user-detail.js" },
    { "source": "/api/assign",          "destination": "/api/assign.js" },
    { "source": "/api/revoke-sessions", "destination": "/api/revoke-sessions.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
