# Copy to .env.local (never commit .env.local).

# Same Neon database as the main shwcs app. Prefer a production-scoped credential
# when deploying; local dev may point at the shared dev database.
DATABASE_URL=

# 32 bytes hex (64 hex characters) used for AES-256-GCM encryption of TOTP secrets
# at rest. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_TOTP_KEY=

# Same-origin checks compare the request's own Origin header against its resolved
# URL (request.nextUrl.origin), so no separate "canonical origin" variable is needed
# — it is correct automatically for whatever domain this deployment is served from.
