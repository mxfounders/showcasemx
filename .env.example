# Database. Use a production-only Neon role and keep SSL required.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Canonical public origin. No trailing slash.
AUTH_APP_ORIGIN=https://shwcs.site
AUTH_EMAIL_FROM=shwcs <hola@shwcs.site>
CONTACT_EMAIL_TO=contacto@shwcs.site
MONITOR_EMAIL_TO=alertas@tu-dominio.com
RESEND_API_KEY=reemplaza_con_una_clave_nueva
# Independent HMAC key for permanent unsubscribe links (at least 32 random characters).
NEWSLETTER_UNSUBSCRIBE_SECRET=reemplaza_con_un_secreto_aleatorio_de_64_caracteres

# OAuth. Callback: https://shwcs.site/api/auth/google/callback
GOOGLE_CLIENT_ID=reemplaza_con_google_client_id
GOOGLE_CLIENT_SECRET=reemplaza_con_google_client_secret

# Generate at least 32 random bytes. Never place it in a URL.
CRON_SECRET=reemplaza_con_un_secreto_aleatorio_de_64_caracteres

# Cifra el secreto TOTP de la verificación en dos pasos (AES-256-GCM).
# Exactamente 32 bytes en hexadecimal: openssl rand -hex 32
# Sin esta clave, Configuración informa que la función no está disponible y nadie
# puede activarla; el acceso con contraseña sigue funcionando igual.
AUTH_TOTP_KEY=reemplaza_con_64_caracteres_hexadecimales

# Production gates.
AUTH_REQUIRE_VERIFIED_EMAIL=true
NEXT_PUBLIC_SHOW_DEMO_PROJECTS=false
LAUNCH_LEGAL_REVIEWED=false
