# Database. Use a production-only Neon role and keep SSL required.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Canonical public origin. No trailing slash.
AUTH_APP_ORIGIN=https://shwcs.site
AUTH_EMAIL_FROM=shwcs <hola@shwcs.site>
CONTACT_EMAIL_TO=contacto@shwcs.site
MONITOR_EMAIL_TO=alertas@tu-dominio.com
RESEND_API_KEY=reemplaza_con_una_clave_nueva
# Independent HMAC key for permanent unsubscribe links (at least 32 random characters).
NEWSLETTER_UNSUBSCRIBE_SECRET=reemplaza_con_un_secreto_aleatorio_de_64_caracteres

# OAuth. Callback: https://shwcs.site/api/auth/google/callback
GOOGLE_CLIENT_ID=reemplaza_con_google_client_id
GOOGLE_CLIENT_SECRET=reemplaza_con_google_client_secret

# Generate at least 32 random bytes. Never place it in a URL.
CRON_SECRET=reemplaza_con_un_secreto_aleatorio_de_64_caracteres

# Cifra el secreto TOTP de la verificación en dos pasos (AES-256-GCM).
# Exactamente 32 bytes en hexadecimal: openssl rand -hex 32
# Sin esta clave, Configuración informa que la función no está disponible y nadie
# puede activarla; el acceso con contraseña sigue funcionando igual.
AUTH_TOTP_KEY=reemplaza_con_64_caracteres_hexadecimales

# Autoriza a ops/ (proyecto Vercel shwcs-ops, otro origen) a invalidar la caché
# del catálogo tras publicar/retirar desde el backoffice. Debe coincidir
# exactamente con CATALOG_REVALIDATE_SECRET en ops/.env.local o su Vercel.
# Sin ella, publicar desde ops sigue funcionando pero el catálogo tarda hasta
# 300s (el TTL de respaldo) en reflejarlo, igual que antes de esta variable.
# openssl rand -hex 32
CATALOG_REVALIDATE_SECRET=reemplaza_con_64_caracteres_hexadecimales

# Autoriza a ops/ a leer bytes de capturas a través de
# /api/internal/media/[solutionId]/[assetId]. ops no lleva token de Blob ni copia
# del predicado §16: proxea por aquí. Debe coincidir con OPS_MEDIA_SECRET en
# ops/. Sin ella, el drawer de revisión de ops no muestra capturas.
# openssl rand -hex 32
OPS_MEDIA_SECRET=reemplaza_con_64_caracteres_hexadecimales

# Vercel Blob (store privado). En el runtime de Vercel se usa OIDC
# (VERCEL_OIDC_TOKEN + BLOB_STORE_ID, inyectados por la integración). En local y
# en scripts hace falta el token estático del panel del store; NO poner
# BLOB_STORE_ID junto a él en local o el SDK lo ignora en favor de OIDC.
BLOB_READ_WRITE_TOKEN=

# Habilita el barredor de blobs huérfanos en /api/internal/monitor. Dejar sin
# poner hasta después de verificar la fase 5 del drop de content_base64: un
# rollback que ponga storage_key a NULL con el barredor activo borraría bytes
# que aún se necesitan.
STORAGE_SWEEP_ENABLED=

# Production gates.
AUTH_REQUIRE_VERIFIED_EMAIL=true
NEXT_PUBLIC_SHOW_DEMO_PROJECTS=false
LAUNCH_LEGAL_REVIEWED=false
